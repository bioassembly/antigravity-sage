{
  "mcpServers": {
    "context7": {
      "url": "https://mcp.context7.com/mcp"
    },
    "deepwiki": {
      "url": "https://mcp.deepwiki.com/mcp"
    },
    "serena": {
      "command": "uvx",
      "args": [
        "serena-agent",
        "start-mcp-server",
        "--context",
        "antigravity",
        "--project-from-cwd",
        "--open-web-dashboard",
        "false"
      ]
    },
    "memory": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-memory@2026.7.4"
      ],
      "env": {
        "MEMORY_FILE_PATH": "${HOME}/.config/opencode/memory.json"
      }
    }
  }
}
