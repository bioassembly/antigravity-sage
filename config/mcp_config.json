{
  "mcpServers": {
    "context7": {
      "url": "https://mcp.context7.com/mcp"
    },
    "deepwiki": {
      "url": "https://mcp.deepwiki.com/mcp"
    },
    "serena": {
      "command": "uvx",
      "args": [
        "--from",
        "serena-agent==2.1.0",
        "serena",
        "start-mcp-server",
        "--context",
        "antigravity",
        "--agent-interface",
        "tools",
        "--open-web-dashboard",
        "false",
        "--enable-gui-log-window",
        "false"
      ]
    },
    "memory": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-memory@2.1.1"
      ],
      "env": {
        "MEMORY_FILE_PATH": "${HOME}/.gemini/config/memory.json"
      },
      "disabled": true
    },
    "openaiDeveloperDocs": {
      "url": "https://developers.openai.com/mcp"
    }
  }
}
